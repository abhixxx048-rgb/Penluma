---
import { SITE } from '../consts';
import NewsletterForm from './NewsletterForm.astro';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 dark:border-slate-800">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <p class="font-semibold">{SITE.title}</p>
        <p class="mt-2 max-w-sm text-sm text-slate-600 dark:text-slate-400">{SITE.tagline}</p>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-500">
          <a class="hover:text-brand-600" href="/tools">Tools</a>
          <a class="hover:text-brand-600" href="/blog">Blog</a>
          <a class="hover:text-brand-600" href="/about">About</a>
          <a class="hover:text-brand-600" href="/contact">Contact</a>
          {SITE.social.twitter && <a class="hover:text-brand-600" href={SITE.social.twitter}>Twitter</a>}
          {SITE.social.github && <a class="hover:text-brand-600" href={SITE.social.github}>GitHub</a>}
          {SITE.social.linkedin && <a class="hover:text-brand-600" href={SITE.social.linkedin}>LinkedIn</a>}
          <a class="hover:text-brand-600" href="/sitemap">Sitemap</a>
          <a class="hover:text-brand-600" href="/rss.xml">RSS</a>
        </div>
      </div>
      <NewsletterForm />
    </div>
    <div class="mt-10 flex flex-col gap-4 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800">
      <p class="text-xs text-slate-400">© {year} {SITE.author}.</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-slate-500">
        <a class="hover:text-brand-600" href="/privacy">Privacy</a>
        <a class="hover:text-brand-600" href="/cookies">Cookies</a>
        <a class="hover:text-brand-600" href="/terms">Terms</a>
        <a class="hover:text-brand-600 cursor-pointer" href="#" data-cookie-settings>Cookie settings</a>
      </nav>
    </div>
  </div>
</footer>
