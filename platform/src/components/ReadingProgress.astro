---
/**
 * ReadingProgress - a slim scroll-progress bar pinned just under the sticky
 * header. Fills left-to-right as the reader scrolls through `target`.
 *
 * Pure CSS/JS, no dependencies. Theme-aware (uses the brand-* ramp, which
 * flips in dark mode), respects prefers-reduced-motion, and hides itself if
 * the target element isn't on the page.
 */
interface Props {
  /** CSS selector for the element whose scroll drives the bar. */
  target?: string;
}
const { target = 'article' } = Astro.props;
---

<div
  id="reading-progress"
  data-target={target}
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-16 z-30 h-0.5"
>
  <span data-progress-bar class="block h-full w-full origin-left scale-x-0 bg-brand-600"></span>
</div>

<style>
  [data-progress-bar] {
    transition: transform 0.1s linear;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-progress-bar] {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const wrap = document.getElementById('reading-progress');
    if (!wrap) return;

    const bar = wrap.querySelector<HTMLElement>('[data-progress-bar]');
    const target = document.querySelector<HTMLElement>(wrap.dataset.target || 'article');

    // Nothing to track → don't show an empty bar.
    if (!bar || !target) {
      wrap.remove();
      return;
    }

    let raf = 0;
    const update = () => {
      raf = 0;
      const top = target.getBoundingClientRect().top + window.scrollY;
      const scrollable = target.offsetHeight - window.innerHeight;
      const scrolled = window.scrollY - top;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, scrolled / scrollable)) : 0;
      bar.style.transform = `scaleX(${progress})`;
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  })();
</script>
