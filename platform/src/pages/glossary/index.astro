---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import glossaryData from '../../data/glossary.json';

interface Term {
  term: string;
  slug: string;
  definition: string;
  learnMore?: string;
  topic?: string;
}

// Resilient: coerce to an array and drop anything without the fields we render.
const terms: Term[] = (Array.isArray(glossaryData) ? (glossaryData as Term[]) : [])
  .filter((t) => t && t.term && t.slug && t.definition)
  .sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));

// First-letter bucket for each term ("#" for anything not A-Z).
const bucketOf = (name: string) => {
  const c = name.trim().charAt(0).toUpperCase();
  return c >= 'A' && c <= 'Z' ? c : '#';
};

// Group into { letter, items } in A-Z order, with "#" last if present.
const byLetter = new Map<string, Term[]>();
for (const t of terms) {
  const b = bucketOf(t.term);
  if (!byLetter.has(b)) byLetter.set(b, []);
  byLetter.get(b)!.push(t);
}
const groups = [...byLetter.entries()]
  .map(([letter, items]) => ({ letter, items }))
  .sort((a, b) => {
    if (a.letter === '#') return 1;
    if (b.letter === '#') return -1;
    return a.letter.localeCompare(b.letter);
  });

const activeLetters = new Set(groups.map((g) => g.letter));
const alphabet = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];

const title = 'Glossary';
const description = `Plain-English definitions of ${terms.length} key terms across product sense, thinking skills, decision psychology, and behavior change - each linked to a deep-dive that explains it in full.`;
const keywords = [
  'glossary',
  'definitions',
  'what is',
  'product sense terms',
  'thinking skills glossary',
  'cognitive biases list',
  'decision-making terms',
  'mental models glossary',
];

const glossaryUrl = new URL('/glossary/', Astro.site).toString();

// DefinedTermSet: the whole glossary as one structured entity, with every
// term as a DefinedTerm pointing at its own canonical page.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': glossaryUrl,
    name: `${SITE.name} Glossary`,
    description,
    url: glossaryUrl,
    hasDefinedTerm: terms.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.term,
      description: t.definition,
      url: new URL(`/glossary/${t.slug}/`, Astro.site).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Glossary', item: glossaryUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <span class="text-slate-700 dark:text-slate-300">Glossary</span>
    </nav>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      Glossary
    </h1>
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
      Plain-English definitions of the ideas that show up across these deep-dives - from
      affordances and cognitive load to base rates, habit loops, and the biases that quietly
      steer your decisions. Every term links to the post that explains it in full.
    </p>

    {terms.length === 0 ? (
      <p class="mt-10 text-slate-600 dark:text-slate-400">No terms yet - check back soon.</p>
    ) : (
      <Fragment>
        {/* A-Z jump nav */}
        <nav aria-label="Jump to letter" class="mt-8 flex flex-wrap gap-1.5">
          {alphabet.map((letter) =>
            activeLetters.has(letter) ? (
              <a
                href={`#letter-${letter}`}
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700 dark:border-slate-800 dark:text-slate-300 dark:hover:border-brand-700 dark:hover:bg-slate-800 dark:hover:text-brand-300"
                >{letter}</a>
            ) : (
              <span
                aria-hidden="true"
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-transparent text-sm font-semibold text-slate-300 dark:text-slate-700"
                >{letter}</span>
            )
          )}
        </nav>

        <div class="mt-10 space-y-12">
          {groups.map((group) => (
            <section id={`letter-${group.letter}`} class="scroll-mt-24">
              <div class="flex items-baseline gap-3 border-b border-slate-200 pb-2 dark:border-slate-800">
                <h2 class="text-2xl font-bold text-brand-700 dark:text-brand-400">{group.letter}</h2>
                <span class="text-xs text-slate-400">
                  {group.items.length} {group.items.length === 1 ? 'term' : 'terms'}
                </span>
              </div>
              <dl class="mt-5 space-y-6">
                {group.items.map((t) => (
                  <div>
                    <dt class="font-semibold text-slate-900 dark:text-white">
                      <a
                        href={`/glossary/${t.slug}`}
                        class="hover:text-brand-700 dark:hover:text-brand-300"
                        >{t.term}</a>
                    </dt>
                    <dd class="mt-1 text-slate-600 dark:text-slate-400">{t.definition}</dd>
                    <dd class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                      <a
                        href={`/glossary/${t.slug}`}
                        class="font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300"
                        >Definition <span aria-hidden="true">→</span></a>
                      {t.topic && (
                        <span class="text-xs text-slate-400">{t.topic}</span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>
      </Fragment>
    )}
  </section>
</BaseLayout>
