---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const url = new URL('/privacy', Astro.site).toString();
const description = `How ${SITE.name} handles your data: privacy-friendly analytics, newsletter and contact details, and your rights. Our writing tools run entirely in your browser.`;
const updated = 'July 2026';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Privacy Policy — ${SITE.name}`,
    description,
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: url },
    ],
  },
];
---

<BaseLayout title="Privacy Policy" description={description} keywords={['privacy policy', 'Penluma', 'data protection', 'GDPR']} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Privacy Policy</h1>
    <p class="mt-2 text-sm text-slate-500">Last updated: {updated}</p>

    <div class="prose-research mt-8">
      <p>
        This policy explains what data {SITE.name} collects, why, and the choices you have. The
        short version: we collect as little as possible, we don't sell your data, and the
        <a href="/tools">writing tools</a> run entirely in your browser — the text you paste into them
        never reaches our servers.
      </p>

      <h2>Who we are</h2>
      <p>
        {SITE.name} is a personal publication of deep-dive writing and free browser-based tools. For any
        privacy question, contact us at
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>
          <strong>Analytics (only with your consent).</strong> We use Google Analytics 4 to understand which
          articles are read and how the site performs. Analytics cookies and identifiers load
          <em>only after you accept</em> in the cookie banner. Until then, Google Consent Mode keeps analytics
          storage denied. See our <a href="/cookies">Cookie Policy</a>.
        </li>
        <li>
          <strong>Newsletter.</strong> If you subscribe, we store the email address you provide so we can send
          you new posts. That's the only field we ask for.
        </li>
        <li>
          <strong>Contact form.</strong> If you message us, we store your name, email, and message so we can
          reply.
        </li>
        <li>
          <strong>Tool input — not collected.</strong> Everything you type into a tool on
          <a href="/tools">/tools</a> is processed locally in your browser with JavaScript. It is never
          uploaded, logged, or stored by us.
        </li>
      </ul>

      <h2>How your data is used</h2>
      <p>
        Analytics data is used in aggregate to improve the site. Your email is used only to send the
        newsletter you asked for. Contact details are used only to respond to you. We do not sell, rent,
        or trade your personal data, and we don't use it for advertising.
      </p>

      <h2>Where it's processed</h2>
      <p>
        The site is hosted on <strong>Cloudflare</strong>, and newsletter/contact submissions are stored in
        Cloudflare's key-value storage. Analytics are processed by <strong>Google</strong> (Google Analytics),
        subject to their own privacy terms. These providers may process data in countries outside your own;
        both operate under standard data-protection safeguards.
      </p>

      <h2>Retention</h2>
      <p>
        We keep newsletter emails until you unsubscribe or ask us to delete them, and contact messages for as
        long as needed to handle your enquiry. Analytics data follows Google's retention settings.
      </p>

      <h2>Your rights</h2>
      <p>
        Depending on where you live (for example, under the GDPR in the EU/UK or the CCPA in California), you
        may have the right to access, correct, export, or delete the personal data we hold about you, and to
        withdraw consent at any time. To exercise any of these, email
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> and we'll act on it promptly. You can
        change your analytics consent whenever you like via
        <a href="#" data-cookie-settings>Cookie settings</a>.
      </p>

      <h2>Children</h2>
      <p>
        {SITE.name} is intended for a general adult audience and is not directed at children under 16. We don't
        knowingly collect data from children.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        We may update this policy as the site evolves. Material changes will be reflected here with a new
        "last updated" date.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about your privacy? Write to
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> or use the
        <a href="/contact">contact page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
