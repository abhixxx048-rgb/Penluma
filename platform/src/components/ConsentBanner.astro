---
// GDPR / ePrivacy cookie-consent banner, wired to Google Consent Mode v2.
//
// Penluma only runs privacy-friendly analytics (GA4) - no ads - so the single
// meaningful toggle is analytics. Consent Mode defaults to DENIED (set in
// BaseLayout <head> before GA loads); this banner lets the visitor grant or keep
// denying it, persists the choice in localStorage, and can be reopened from any
// "Cookie settings" control (elements with the data-cookie-settings attribute).
//
// NOTE: For a fully certified EEA/UK setup Google recommends a certified CMP.
// This is a solid baseline: nothing that stores analytics cookies runs until the
// visitor opts in, and the choice is remembered + revocable.
---

<div
  id="cookie-banner"
  hidden
  role="dialog"
  aria-modal="false"
  aria-label="Cookie consent"
  class="fixed inset-x-0 bottom-0 z-[60] border-t border-slate-200 bg-white p-4 shadow-lg sm:inset-x-auto sm:bottom-4 sm:left-4 sm:max-w-sm sm:rounded-2xl sm:border dark:border-slate-800 dark:bg-slate-900"
  style="padding-bottom: calc(1rem + env(safe-area-inset-bottom));"
>
  <p class="text-sm font-semibold">Cookies on Penluma</p>
  <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">
    We use privacy-friendly analytics to understand what's read. Nothing loads until you
    choose. See our <a href="/cookies" class="underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500 dark:decoration-slate-600">Cookie Policy</a>.
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button
      id="cc-accept"
      class="min-h-11 flex-1 rounded-lg bg-brand-700 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200"
      >Accept</button
    >
    <button
      id="cc-decline"
      class="min-h-11 flex-1 rounded-lg border border-slate-300 px-4 text-sm font-semibold transition-colors hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
      >Decline</button
    >
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'consent_v2';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    function gtag() {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(arguments);
    }

    // Show the banner only if the visitor hasn't chosen yet.
    var saved = null;
    try {
      saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    } catch (e) {}
    if (!saved) banner.hidden = false;

    function set(granted) {
      var state = {
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
        analytics_storage: granted ? 'granted' : 'denied',
      };
      gtag('consent', 'update', state);
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch (e) {}
      banner.hidden = true;
    }

    var a = document.getElementById('cc-accept');
    var d = document.getElementById('cc-decline');
    if (a) a.addEventListener('click', function () { set(true); });
    if (d) d.addEventListener('click', function () { set(false); });

    // Reopen from any "Cookie settings" control anywhere on the site.
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.closest && t.closest('[data-cookie-settings]')) {
        e.preventDefault();
        banner.hidden = false;
      }
    });
  })();
</script>
