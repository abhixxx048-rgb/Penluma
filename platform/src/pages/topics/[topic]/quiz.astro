---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Quiz from '../../../components/Quiz.astro';
import { topicBySlug } from '../../../lib/content';
import { QUIZZES } from '../../../data/quizzes';

// One quiz page per topic that has an entry in the quiz registry.
export async function getStaticPaths() {
  return Object.keys(QUIZZES).map((slug) => ({ params: { topic: slug } }));
}

const { topic: slug } = Astro.params;
const topic = topicBySlug(slug!)!;
const quiz = QUIZZES[slug!];
const total = quiz.questions.length;

const abs = (path: string) => new URL(path, Astro.site).toString();
const siteRoot = abs('/');
const topicUrl = abs(`/topics/${slug}`);
const quizUrl = abs(`/topics/${slug}/quiz`);

const description = `Free interactive ${topic.title} practice quiz — ${total} questions. ${quiz.intro}`;
const keywords = [
  `${topic.title} practice questions`,
  `${topic.title} quiz`,
  `${topic.title} MCQ`,
  ...(quiz.badge ? [`${quiz.badge} practice test`] : []),
  'interactive quiz',
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    name: `${topic.title} Practice Quiz`,
    description,
    url: quizUrl,
    educationalLevel: 'Beginner',
    about: { '@type': 'Thing', name: topic.title },
    numberOfQuestions: total,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
      { '@type': 'ListItem', position: 2, name: 'Topics', item: abs('/topics') },
      { '@type': 'ListItem', position: 3, name: topic.title, item: topicUrl },
      { '@type': 'ListItem', position: 4, name: 'Quiz', item: quizUrl },
    ],
  },
];
---

<BaseLayout title={`${topic.title} Quiz`} description={description} keywords={keywords} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-500 dark:text-slate-400">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-brand-600 hover:underline dark:hover:text-brand-400">Home</a></li>
        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
        <li><a href="/topics" class="hover:text-brand-600 hover:underline dark:hover:text-brand-400">Topics</a></li>
        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
        <li><a href={`/topics/${slug}`} class="hover:text-brand-600 hover:underline dark:hover:text-brand-400">{topic.title}</a></li>
        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
        <li aria-current="page" class="text-slate-700 dark:text-slate-300">Quiz</li>
      </ol>
    </nav>

    <a href={`/topics/${slug}`} class="text-sm text-brand-600 hover:underline dark:text-brand-400">← Back to {topic.title}</a>

    <div class="mt-4 flex items-start gap-4">
      <div class="text-4xl">{topic.icon}</div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{topic.title} — Quiz</h1>
          {quiz.badge && (
            <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500 dark:bg-slate-800 dark:text-slate-400">
              {quiz.badge}
            </span>
          )}
        </div>
        <p class="mt-2 text-slate-600 dark:text-slate-400">{quiz.intro}</p>
        <p class="mt-2 text-sm text-slate-400">{total} questions</p>
      </div>
    </div>

    <div class="mt-8">
      <Quiz questions={quiz.questions} />
    </div>
  </section>
</BaseLayout>
