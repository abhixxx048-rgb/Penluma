---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const url = new URL('/terms', Astro.site).toString();
const description = `The terms of use for ${SITE.name} — the writing, the free browser-based tools, and the usual fair-use and no-warranty basics.`;
const updated = 'July 2026';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Terms of Use — ${SITE.name}`,
    description,
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Terms of Use', item: url },
    ],
  },
];
---

<BaseLayout title="Terms of Use" description={description} keywords={['terms of use', 'terms of service', 'Penluma']} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Terms of Use</h1>
    <p class="mt-2 text-sm text-slate-500">Last updated: {updated}</p>

    <div class="prose-research mt-8">
      <p>
        By using {SITE.name} (the "site"), including the articles and the free browser-based
        <a href="/tools">tools</a>, you agree to these terms. If you don't agree, please don't use the site.
      </p>

      <h2>Using the site and tools</h2>
      <p>
        You may read, share, and use the tools for personal and commercial work. The tools run entirely in
        your browser and are provided as a convenience. Please don't misuse the site — for example, by
        attempting to disrupt it, scrape it at abusive rates, or use it for anything unlawful.
      </p>

      <h2>Content and intellectual property</h2>
      <p>
        The articles, design, and original code of {SITE.name} are the property of their author and are
        protected by copyright. You're welcome to quote and link to the writing with attribution; please don't
        republish whole articles as your own. Any text <em>you</em> process with the tools remains entirely
        yours — we never receive or claim any rights to it.
      </p>

      <h2>No professional advice</h2>
      <p>
        The writing is for general information and education. It is not legal, financial, medical, or other
        professional advice, and you should consult a qualified professional before acting on anything you read
        here.
      </p>

      <h2>"As is", no warranty</h2>
      <p>
        The site and tools are provided "as is" and "as available", without warranties of any kind, express or
        implied. We don't guarantee that the tools are error-free, that results are accurate, or that the site
        will always be available. You use them at your own discretion and risk.
      </p>

      <h2>Limitation of liability</h2>
      <p>
        To the fullest extent permitted by law, {SITE.name} and its author will not be liable for any indirect,
        incidental, or consequential damages arising from your use of the site or tools, including any loss of
        data. Because the tools run locally in your browser, keep your own copies of anything important.
      </p>

      <h2>External links</h2>
      <p>
        The site may link to third-party websites. We're not responsible for their content or practices; visit
        them at your own discretion.
      </p>

      <h2>Changes</h2>
      <p>
        We may update these terms from time to time. Continued use of the site after changes means you accept
        the updated terms. The "last updated" date above reflects the current version.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about these terms? Email
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> or use the
        <a href="/contact">contact page</a>. See also our <a href="/privacy">Privacy Policy</a> and
        <a href="/cookies">Cookie Policy</a>.
      </p>
    </div>
  </section>
</BaseLayout>
