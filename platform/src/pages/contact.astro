---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const contactUrl = new URL('/contact', Astro.site).toString();
const description = `Get in touch with ${SITE.name} - questions, corrections, suggestions for a deep-dive, or just to say hello. I read every message.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${SITE.name}`,
    description,
    url: contactUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: contactUrl },
    ],
  },
];

const inputClass =
  'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 dark:border-slate-700 dark:bg-slate-900';
---

<BaseLayout title="Contact" description={description} keywords={['contact', 'Penluma', 'get in touch']} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      Get in touch
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      Questions, corrections, a topic you'd love to see worked through, or just a hello -
      send it over. I read every message.
    </p>

    <div class="mt-10 grid gap-10 sm:grid-cols-5">
      {/* Form */}
      <div class="sm:col-span-3">
        <form id="contact-form" method="post" action="/api/contact" class="space-y-4" novalidate>
          <div>
            <label for="c-name" class="text-sm font-medium">Name</label>
            <input id="c-name" name="name" type="text" required autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="c-email" class="text-sm font-medium">Email</label>
            <input id="c-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class={inputClass} />
          </div>
          <div>
            <label for="c-message" class="text-sm font-medium">Message</label>
            <textarea id="c-message" name="message" rows="6" required class={inputClass}></textarea>
          </div>
          {/* Honeypot - hidden from humans, catches bots. Named so browser
              autofill never touches it (a "company"/"organization" field DOES
              get autofilled, which would falsely flag a real person as a bot). */}
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label>Leave this empty<input name="botcheck" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="flex items-center gap-4">
            <button
              type="submit"
              class="rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800 disabled:opacity-50 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200"
              >Send message</button
            >
            <p id="contact-msg" class="hidden text-sm" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>

      {/* Aside */}
      <aside class="sm:col-span-2">
        <div class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
          <p class="font-semibold">Prefer email?</p>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Write to
            <a class="font-medium underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500 dark:decoration-slate-600" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
            and I'll get back to you.
          </p>
          <hr class="my-5 border-slate-200 dark:border-slate-800" />
          <p class="font-semibold">Looking for something?</p>
          <ul class="mt-2 space-y-1.5 text-sm text-slate-600 dark:text-slate-400">
            <li><a class="hover:text-brand-600 dark:hover:text-brand-300" href="/tools">Free writing tools</a></li>
            <li><a class="hover:text-brand-600 dark:hover:text-brand-300" href="/blog">All deep-dives</a></li>
            <li><a class="hover:text-brand-600 dark:hover:text-brand-300" href="/topics">Browse topics</a></li>
            <li><a class="hover:text-brand-600 dark:hover:text-brand-300" href="/about">About Penluma</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Wrapped in an IIFE so `form`/`msg`/`btn` stay local — other is:inline
  // scripts on the page (the footer newsletter form) share the global scope and
  // also declare `form`/`msg`, which would throw "already declared".
  (() => {
  const form = document.getElementById('contact-form');
  const msg = document.getElementById('contact-msg');
  const btn = form?.querySelector('button[type="submit"]');

  // Surface the result of a no-JS (native form) submit that redirected back
  // here, then strip the query string so a refresh doesn't repeat it.
  (() => {
    const p = new URLSearchParams(location.search);
    if (!msg || (!p.has('sent') && !p.has('error'))) return;
    msg.classList.remove('hidden');
    if (p.has('sent')) {
      msg.classList.add('text-green-600');
      msg.textContent = 'Thanks — your message has been sent. I read every one.';
    } else {
      msg.classList.add('text-red-500');
      msg.textContent = p.get('error') || 'Something went wrong. Please try again.';
    }
    history.replaceState(null, '', location.pathname);
  })();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    msg.classList.remove('hidden', 'text-red-500', 'text-green-600');
    msg.classList.add('text-slate-500');
    msg.textContent = 'Sending…';
    if (btn) btn.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const body = await res.json().catch(() => ({}));
      msg.classList.remove('text-slate-500');
      if (res.ok) {
        msg.classList.add('text-green-600');
        msg.textContent = body.message || 'Thanks - your message has been sent.';
        form.reset();
      } else {
        msg.classList.add('text-red-500');
        msg.textContent = body.error || 'Something went wrong. Please try again.';
      }
    } catch {
      msg.classList.remove('text-slate-500');
      msg.classList.add('text-red-500');
      msg.textContent = 'Network error. Please try again.';
    } finally {
      if (btn) btn.disabled = false;
    }
  });
  })();
</script>
